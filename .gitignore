node_modules/
# Cada auditoría genera evidencia pesada (capturas, lighthouse). Se conserva solo el reporte final.
reportes/*/evidencia/
reportes/*/puntajes/
# Quién envió cada liga, avance del lote y bitácoras locales (los nombres ya van en calificaciones.csv)
reportes/lote.json
reportes/*/participantes.json
reportes/*/auditar.log

# PDF generados (se regeneran con scripts/pdf.mjs)
reportes/*/reporte.pdf

# Costos de los especialistas por corrida (se regenera con scripts/especialistas.mjs)
reportes/*/costos.json
